# =============================================================================
# Environment / Secrets
# =============================================================================
.env
.env.*
!.env.example        # keep the example template committed

# =============================================================================
# Go build artifacts
# =============================================================================
# Compiled binaries (service entrypoint)
bin/
dist/
server
server.exe
mutualfundanalysis
mutualfundanalysis.exe

# Test binaries produced by `go test -c`
*.test
*.test.exe

# Go test & build cache (managed by the toolchain, not source)
# These live in $GOCACHE / $GOPATH, but guard against accidental local dirs
/tmp/

# Profiling and coverage output
*.out
*.prof
*.pprof
coverage.out
coverage.html
cpu.prof
mem.prof

# =============================================================================
# Go modules
# =============================================================================
# go.mod and go.sum MUST be committed.
# vendor/ is ignored because this project uses the module proxy (go.sum).
# If you ever run `go mod vendor`, remove this line.
vendor/

# =============================================================================
# IDE / Editor
# =============================================================================
# VS Code
.vscode/

# JetBrains (GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*~

# Sublime Text
*.sublime-workspace
*.sublime-project

# Eclipse
.project
.classpath
.settings/
*.launch
.c9/

# =============================================================================
# OS-generated files
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~

# =============================================================================
# Logs
# =============================================================================
*.log
logs/

# =============================================================================
# Temporary / scratch
# =============================================================================
tmp/
temp/
*.tmp
scratch/
